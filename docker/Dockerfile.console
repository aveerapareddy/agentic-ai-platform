FROM node:20-bookworm-slim AS build

WORKDIR /app
COPY services/operator-console/package.json services/operator-console/package-lock.json* ./
RUN npm install --no-audit --no-fund

COPY services/operator-console/ ./
RUN npm run build

FROM nginx:1.27-alpine

COPY docker/nginx-console.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist/operator-console/browser /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=10s --timeout=3s --retries=3 \
  CMD wget -q -O /dev/null http://127.0.0.1/ || exit 1
