# Copy to .env for local development. Do not commit secrets.

# --- General ---
ENVIRONMENT=development
LOG_LEVEL=info

# --- PostgreSQL (docker compose default) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=agentic_dev
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/agentic_dev
ORCHESTRATOR_DATABASE_URL=

# --- api-gateway ---
GATEWAY_PORT=8080
GATEWAY_USE_POSTGRES=false
GATEWAY_ALLOW_DEV_PRINCIPAL_FALLBACK=true
GATEWAY_DEV_PRINCIPAL_ID=dev-operator
GATEWAY_DEV_TENANT_ID=dev-tenant
GATEWAY_DEV_ROLES=operator,admin,approver
GATEWAY_SCHEDULE_EXECUTION_START=true
GATEWAY_USE_EXECUTION_WORKER_QUEUE=true
GATEWAY_STREAM_POLL_INTERVAL_MS=500
GATEWAY_STREAM_HEARTBEAT_SEC=15
GATEWAY_STREAM_MAX_DURATION_SEC=600

# --- model-runtime (fake = no API keys required) ---
MODEL_PROVIDER=fake
# MODEL_API_KEY=
# MODEL_BASE_URL=
# OPENAI_API_KEY=
# AZURE_OPENAI_API_KEY=

# --- operator-console (host dev: ng serve proxies /v1 → gateway) ---
CONSOLE_PORT=4200
# API_BASE_URL=   # empty = same origin; set only for custom deployments

# --- demo seed script ---
GATEWAY_URL=http://127.0.0.1:8080
DEMO_TENANT_ID=dev-tenant
DEMO_PRINCIPAL_ID=demo-seed
DEMO_ROLES=operator,admin,approver
DEMO_ENVIRONMENT=dev

# --- optional Postgres integration tests ---
# ORCHESTRATOR_TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/agentic_test

# --- placeholders (not wired in local stack) ---
ARTIFACT_STORE_URL=
POLICY_ENGINE_URL=
